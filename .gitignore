.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/
.env
*.log

# Accidentally extracted here once by a malformed shell command.
gcloud auth login/
google-cloud-sdk/

# Terraform working directories and state. State can contain resource metadata and
# secret *references*; it does not belong in a public repository.
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Working plans, kept locally and out of the repository.
#
# changes_that_must_be_made.md is a v2 rebuild plan that labels four of its own findings
# "fatal" and "severe". Those findings were acted on — the claims are withdrawn or
# corrected, the controls are built, and tests pin them — but the document is written in
# the present tense and carries no dates, so a reader browsing the file list finds an
# indictment with no way to tell it was resolved. docs/AUDIT.md is the same content in the
# past tense, with each finding linked to the commit and the test that closed it.
changes_that_must_be_made.md
frontendplan.md

# Terminal cast files: the raw timing capture behind the rendered mp4s. The video is the
# artifact; the cast is a build input and can be regenerated by re-running the command.
docs/media/terminal/*.cast.json
